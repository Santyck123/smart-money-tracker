# Etherscan API V2 — una sola key, multichain (Ethereum chainid=1, BNB Chain chainid=56)
ETHERSCAN_API_KEY=

# Helius (Solana) — Enhanced Transactions API + RPC
HELIUS_API_KEY=

# Opcional: nivel de log (debug | info | warn | error). Default: info
LOG_LEVEL=info

# Opcionales del panel/server:
# Corridas automáticas del pipeline cada N horas (0 o vacío = desactivado)
# RUN_INTERVAL_HOURS=6
# Token para proteger POST /api/run cuando el server está expuesto a internet.
# n8n u otro orquestador debe mandar header: Authorization: Bearer <token>
# API_TOKEN=

# Opcionales: criterios de pump (defaults si no se setean)
# PUMP_MIN_PRICE_CHANGE_24H=200
# PUMP_MIN_VOLUME_24H_USD=100000
# PUMP_MIN_LIQUIDITY_USD=20000
# PUMP_MIN_PAIR_AGE_DAYS=1
# PUMP_MAX_PAIR_AGE_DAYS=30
